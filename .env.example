# Unified Calendar API Configuration
# Copy this file to .env and fill in your actual API key

# Your Unified Calendar API key for integration tests
UNIFIED_API_KEY=your-api-key-here

# Optional: Override the base URL (defaults to https://api.onecalunified.com)
# For local development, uncomment and set to your local server:
UNIFIED_API_BASE_URL=http://localhost:3000
